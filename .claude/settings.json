{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(pnpm:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx prettier:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(test:*)",
      "Bash(xargs:*)",
      "Bash(curl:*)",
      "Bash(lsof:*)",
      "Bash(gh:*)",
      "WebSearch",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:docs.nestjs.com)",
      "WebFetch(domain:docs.claude.com)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .)",
      "Bash(chmod 777*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git branch -D*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(curl * | python*)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(eval *curl*)",
      "Bash(eval *wget*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cp ~/.ssh/*)",
      "Bash(scp ~/.ssh/*)",
      "Bash(base64 ~/.ssh/*)",
      "Bash(cat */.env*)",
      "Bash(cp */.env*)",
      "Bash(scp */.env*)",
      "Bash(base64 */.env*)",
      "Bash(cat *credentials*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(pnpm db:migrate:up*)",
      "Bash(pnpm db:migrate:revert*)",
      "Bash(pnpm db:migrate:fake*)",
      "Bash(npx typeorm migration:run*)",
      "Bash(npx typeorm migration:revert*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(docker *)",
      "Bash(rm *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(redis-cli*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-secrets.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/precompact.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
