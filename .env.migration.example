# ---------------------------------------------------------------------------
# 마이그레이션 CLI 전용. 이 파일을 .env.migration 으로 복사해 값을 채운다. 커밋하지 않는다.
# 앱 .env 와 분리하는 이유: **계정이 다르다** — nerd_migrator 만 DDL 권한이 있다.
# 사람이 scripts/db-tunnel.sh 로 터널을 열고 `pnpm migration:run` 을 실행한다.
# 🚫 AI 는 마이그레이션을 실행하지 않는다 (CLAUDE.md Never) — 전 환경이 같은 DB 라 실행이 곧 상용 적용이다.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nerd_migrator
DB_PASSWORD=
DB_NAME=nerd
DB_POOL_SIZE=1
