{
  "name": "nerd",
  "version": "0.1.0",
  "private": true,
  "description": "nerd 모노레포 — apps/back(NestJS) · apps/front(Next.js). 루트는 오케스트레이션만, 의존성 0",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "back": "pnpm --filter nerd-back...",
    "front": "pnpm --filter nerd-front...",
    "db:migrate:list": "pnpm --filter nerd-back run db:migrate:list",
    "db:migrate:generate": "pnpm --filter nerd-back run db:migrate:generate",
    "db:migrate:up": "pnpm --filter nerd-back run db:migrate:up",
    "db:migrate:revert": "pnpm --filter nerd-back run db:migrate:revert",
    "lint": "pnpm -r run lint",
    "ci:core": "pnpm -r run ci:core",
    "ci:all": "pnpm -r run ci:all"
  }
}
