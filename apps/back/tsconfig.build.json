{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // emit 하는 설정은 이 파일뿐이므로 rootDir 도 여기에만 둔다.
    // dist 최상위에 main.js 가 놓이려면 rootDir 이 src 여야 한다 (없으면 dist/src/main.js 가 된다).
    "rootDir": "./src"
  },
  // 프로덕션 빌드 입력에서 테스트·스펙을 제외한다.
  // ⚠️ 이 파일은 tsconfig.json 을 extends 하므로 Dockerfile 의 COPY 목록에 두 파일이 모두 있어야 한다.
  //    하나라도 빠지면 컨테이너 빌드가 TS5058 로 실패한다 (docs/lessons.md 참조).
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "**/__spec__/**"]
}
