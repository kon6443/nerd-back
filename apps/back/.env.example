# ---------------------------------------------------------------------------
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 부팅 시 src/config/env.validation.ts 가 검증하고, 누락되면 기동에 실패한다.
# ---------------------------------------------------------------------------

# 실행 환경. LOCAL | PROD
ENV=LOCAL

# HTTP 포트. 컨테이너 내부 포트도 동일하게 5501 을 쓴다.
PORT=5501

# 로그 레벨. LOCAL 은 debug, PROD 는 info
LOG_LEVEL=debug

# CORS 허용 오리진. 쉼표로 구분. 비우면 모든 요청을 차단한다.
CORS_ORIGINS=http://localhost:5502

# Redis — 레이트리밋 스토리지와 카운터에 쓴다.
# ⚠️ **인증에는 쓰지 않는다** (2026-09-07 부터 세션이 서명 쿠키다). 즉 Redis 가 없어도
#    로그인·가입은 동작하고, 레이트리밋만 fail-open 으로 느슨해진다.
# 로컬: 127.0.0.1
# 배포: Redis 스택의 서비스 DNS → prod_nerd_cache_redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 비밀번호가 없으면 비워 둔다. overlay 내부 통신이라 외부 노출은 없다.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# 세션 쿠키 서명 키 (32자 이상). 생성: openssl rand -base64 32
#
# ⭐ 레플리카 3개가 **같은 값**을 써야 한다. 다르면 A 가 심은 쿠키를 B 가 위조로 보고 거절해
#    "새로고침할 때마다 로그아웃" 으로 드러난다.
# ⚠️ 이 값을 바꾸면 **모든 사용자가 로그아웃된다.** 서버측 세션이 없으므로 이것이 유일한
#    「전체 강제 로그아웃」 수단이다.
# 🚫 기본값이 없다 — 있으면 모든 배포가 같은 키를 써서 누구나 남의 세션을 만들 수 있다.
# ---------------------------------------------------------------------------
SESSION_SECRET=

# Swarm 이 주입한다 ({{.Task.Slot}}). 로컬에서는 1 로 둔다.
# 여러 레플리카 중 하나만 실행해야 하는 작업의 가드로 쓴다.
TASK_SLOT=1

# 엣지 백스톱 레이트리밋. true | false (기본 false)
# Nest 가드가 닿지 않는 경로(Swagger UI·스펙 JSON·404)를 IP 당 분당 300 으로 덮는다.
# 꺼져 있으면 미들웨어를 아예 등록하지 않는다. 켜기 전에 정상 트래픽이 이 한도에
# 닿지 않는지 확인한다 — 닿으면 정상 사용자가 429 를 받는다.
EDGE_THROTTLE_ENABLED=false

# MySQL — 앱 계정 nerd_app (DML 만. 테이블 생성·삭제 권한 없음).
# 배포·로컬이 **같은 서버 DB** 를 쓴다 — 로컬용 DB 는 없다 (docs/tasks/archive/tasks-db-mysql.md D1).
# 로컬: scripts/db-tunnel.sh 로 터널을 열고 127.0.0.1 로 붙는다
# 배포: DB 스택의 서비스 DNS → prod_nerd_db_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nerd_app
DB_PASSWORD=
DB_NAME=nerd
# 커넥션 풀 크기 (기본 10, 최대 30). 레플리카 3 × 풀 + 운영 여유 ≤ MySQL max_connections(100)
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# 마이그레이션 CLI 전용 계정 (`pnpm db:migrate:*`).
#
# ⚠️ 위 DB_USER(nerd_app)에는 **DDL 권한이 없다** — 코드 경로에서 스키마가 바뀔 수 없게 하려는
#    의도된 제약이다. 그래서 마이그레이션만 이 계정으로 붙는다.
# 🚫 이 두 줄을 지우고 위 DB_USER 를 nerd_migrator 로 바꾸지 말 것. 앱이 도는 동안 스키마가
#    바뀔 수 있게 된다.
#
# 둘 다 비워 두면 앱 계정으로 붙어 **네 명령 모두** 권한 오류(1142)로 실패한다.
# ⚠️ `db:migrate:list` 도 마찬가지다 — TypeORM 의 migration:show 는 migrations 테이블이 없으면
#    테이블 생성 DDL 을 먼저 던진다. 이름과 달리 조회가 아니다 (2026-09-04 실측).
# **둘 중 하나만 채우면 접속 전에 막는다.**
# ---------------------------------------------------------------------------
DB_MIGRATION_USER=nerd_migrator
DB_MIGRATION_PASSWORD=
