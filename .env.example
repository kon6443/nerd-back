# ---------------------------------------------------------------------------
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
# 부팅 시 src/config/env.validation.ts 가 검증하고, 누락되면 기동에 실패한다.
# ---------------------------------------------------------------------------

# 실행 환경. LOCAL | PROD
ENV=LOCAL

# HTTP 포트. 컨테이너 내부 포트도 동일하게 5501 을 쓴다.
PORT=5501

# 로그 레벨. LOCAL 은 debug, PROD 는 info
LOG_LEVEL=debug

# CORS 허용 오리진. 쉼표로 구분. 비우면 모든 요청을 차단한다.
CORS_ORIGINS=http://localhost:5502

# Redis — 레이트리밋 스토리지와 카운터에 쓴다.
# 로컬: 127.0.0.1
# 배포: Redis 스택의 서비스 DNS → prod_nerd_cache_redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 비밀번호가 없으면 비워 둔다. overlay 내부 통신이라 외부 노출은 없다.
REDIS_PASSWORD=

# Swarm 이 주입한다 ({{.Task.Slot}}). 로컬에서는 1 로 둔다.
# 여러 레플리카 중 하나만 실행해야 하는 작업의 가드로 쓴다.
TASK_SLOT=1

# 엣지 백스톱 레이트리밋. true | false (기본 false)
# Nest 가드가 닿지 않는 경로(Swagger UI·스펙 JSON·404)를 IP 당 분당 300 으로 덮는다.
# 꺼져 있으면 미들웨어를 아예 등록하지 않는다. 켜기 전에 정상 트래픽이 이 한도에
# 닿지 않는지 확인한다 — 닿으면 정상 사용자가 429 를 받는다.
EDGE_THROTTLE_ENABLED=false

# MySQL — 앱 계정 nerd_app (DML 만. 테이블 생성·삭제 권한 없음).
# 배포·로컬이 **같은 서버 DB** 를 쓴다 — 로컬용 DB 는 없다 (docs/tasks/tasks-db-mysql.md D1).
# 로컬: scripts/db-tunnel.sh 로 터널을 열고 127.0.0.1 로 붙는다
# 배포: DB 스택의 서비스 DNS → prod_nerd_db_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nerd_app
DB_PASSWORD=
DB_NAME=nerd
# 커넥션 풀 크기 (기본 10, 최대 30). 레플리카 3 × 풀 + 운영 여유 ≤ MySQL max_connections(100)
DB_POOL_SIZE=10
